# R
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# Output (regenerated by scripts — lives inside LaTeX/)
# Ignore contents but keep .gitkeep so the folders are tracked
LaTeX/Figures/*
LaTeX/Tables/*
LaTeX/Text/*
!LaTeX/Figures/.gitkeep
!LaTeX/Tables/.gitkeep
!LaTeX/Text/.gitkeep

# Identifiable raw data: never committed (keep the folder via .gitkeep)
Data/raw_SENSITIVE/*
!Data/raw_SENSITIVE/.gitkeep

# Agent/worker scratch, briefs and notes (keep the folder via .gitkeep)
_ai/*
!_ai/.gitkeep

# LaTeX auxiliary files
LaTeX/*.aux
LaTeX/*.log
LaTeX/*.out
LaTeX/*.bbl
LaTeX/*.blg
LaTeX/*.fdb_latexmk
LaTeX/*.fls
LaTeX/*.synctex.gz
LaTeX/*.toc

